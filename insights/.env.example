# Copy to insights/.env (git-ignored) and fill in. Never commit real values.

# Development database used by the insights service and migrations (Phase 3+).
POLYBOT_DATABASE_URL=postgresql://polybot_app:CHANGE_ME@127.0.0.1:5432/polybot

# Exact origin of your installed extension (find the ID at chrome://extensions with
# Developer mode on). Comma-separate several. No wildcards: other origins get HTTP 403.
POLYBOT_ALLOWED_ORIGINS=chrome-extension://REPLACE_WITH_32_CHARACTER_EXTENSION_ID

# Optional: port for `python -m polybot_insights.api` (the extension defaults to 17495).
# POLYBOT_INSIGHTS_PORT=17495

# Optional: run tests against an existing database instead of a temporary cluster.
# The database name MUST end in _test, because tests drop and recreate schemas.
# POLYBOT_TEST_DATABASE_URL=postgresql://polybot_app:CHANGE_ME@127.0.0.1:5432/polybot_test

# Optional: folder containing initdb/pg_ctl when they are not on PATH.
# POLYBOT_PG_BIN=C:\Program Files\PostgreSQL\18\bin
