# Copy to server/.env and supply your own Azure Speech resource values.
# This file must stay outside extension settings and must not be committed with secrets.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
# Alternatively, use an official custom Speech resource origin and omit REGION:
# AZURE_SPEECH_ENDPOINT=https://your-resource.cognitiveservices.azure.com

# Required: exact origins, comma separated, no trailing slash or wildcard.
# Replace the placeholder with your extension ID shown on chrome://extensions.
ALLOWED_ORIGINS=chrome-extension://REPLACE_WITH_EXTENSION_ID
# For local development, explicitly add the actual preview origin, for example:
# ALLOWED_ORIGINS=chrome-extension://your32letterextensionid,http://127.0.0.1:4173
ASSESSMENT_PORT=17494
ASSESSMENT_LOCALES=es-MX,es-ES
